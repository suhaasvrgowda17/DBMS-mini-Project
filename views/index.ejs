<%- include('partials/header') %>
<%- include('partials/navbar') %>

<!-- Hero Banner Section -->
<section class="hero-section text-white d-flex align-items-center justify-content-center text-center animate__animated animate__fadeIn">
  <div class="hero-overlay"></div>
  <div class="container hero-content animate__animated animate__zoomIn animate__delay-1s">
    <span class="badge bg-primary text-uppercase px-3 py-2 mb-3 fw-bold letter-spacing-1 rounded-pill">Unveil The World</span>
    <h1 class="display-3 fw-bold mb-3 font-outfit">Embark on Your Next <br><span class="text-gradient">Great Adventure</span></h1>
    <p class="lead mb-4 mx-auto text-light opacity-90" style="max-width: 600px;">
      Explore premium, hand-crafted packages, manage customer itineraries, and track payments seamlessly through our centralized Travel Agency platform.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <a href="#tour-packages" class="btn btn-primary btn-lg rounded-pill px-5 fw-semibold shadow"><i class="fa-solid fa-map-location-dot me-2"></i> Browse Destinations</a>
      <a href="/login" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-semibold"><i class="fa-solid fa-gauge-high me-2"></i> Log In Workspace</a>
    </div>
  </div>
</section>

<!-- Stats / Highlights Row -->
<section class="container mt-n5 position-relative z-index-2 animate__animated animate__fadeInUp animate__delay-1s">
  <div class="row g-4">
    <div class="col-md-4">
      <div class="card card-glass border-0 text-center py-4 px-3 shadow-sm hover-translate-y">
        <div class="icon-box bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
          <i class="fa-solid fa-globe fs-4"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Global Destinations</h5>
        <p class="text-muted fs-7 mb-0">Unforgettable curated packages across multiple continents.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-glass border-0 text-center py-4 px-3 shadow-sm hover-translate-y">
        <div class="icon-box bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
          <i class="fa-solid fa-shield-halved fs-4"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Secure Bookings</h5>
        <p class="text-muted fs-7 mb-0">Role-based data safety and robust payment invoicing.</p>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card card-glass border-0 text-center py-4 px-3 shadow-sm hover-translate-y">
        <div class="icon-box bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
          <i class="fa-solid fa-user-tie fs-4"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Assigned Agents</h5>
        <p class="text-muted fs-7 mb-0">Expert coordination for streamlined travel operations.</p>
      </div>
    </div>
  </div>
</section>

<!-- Tour Packages Section -->
<section id="tour-packages" class="container py-6">
  <div class="text-center mb-5 animate__animated animate__fadeInUp">
    <span class="text-primary fw-bold text-uppercase letter-spacing-2 fs-7">Hot Deals</span>
    <h2 class="fw-bold text-dark font-outfit mt-1">Featured Tour Packages</h2>
    <div class="divider bg-primary mx-auto my-3" style="width: 60px; height: 4px; border-radius: 2px;"></div>
    <p class="text-muted mx-auto" style="max-width: 500px;">
      Discover incredible vacation packages. Type keywords below to filter destinations instantly.
    </p>

    <!-- Instant Search Box -->
    <div class="row justify-content-center mt-4">
      <div class="col-md-6 col-lg-5">
        <div class="input-group search-bar-wrapper shadow-sm rounded-pill overflow-hidden border">
          <span class="input-group-text bg-white border-0 ps-3 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
          <input type="text" id="packageSearchInput" class="form-control border-0 py-2 shadow-none" placeholder="Search by Maldives, Switzerland, Alps...">
          <button class="btn btn-primary px-4 fw-semibold border-0" type="button" id="packageSearchBtn">Filter</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Packages Grid Container -->
  <div class="row g-4 justify-content-center" id="landingPackagesGrid">
    <!-- Dynamic Cards loaded via AJAX/JS -->
    <div class="col-12 text-center py-5">
      <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Loading tour packages...</span>
      </div>
      <p class="text-muted mt-2">Loading active travel programs...</p>
    </div>
  </div>
</section>

<!-- EJS Javascript Integration for Index Page -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('packageSearchInput');
    const searchBtn = document.getElementById('packageSearchBtn');
    const grid = document.getElementById('landingPackagesGrid');

    // Fetch and render packages
    const fetchPackages = async (query = '') => {
      try {
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Retrieving destinations...</p>
          </div>
        `;
        const response = await fetch(`/api/packages?search=${encodeURIComponent(query)}`);
        const result = await response.json();
        
        if (result.success && result.data.length > 0) {
          grid.innerHTML = '';
          result.data.forEach(pack => {
            const cardHtml = `
              <div class="col-md-6 col-lg-4 animate__animated animate__fadeInUp">
                <div class="card card-package h-100 border-0 shadow-sm overflow-hidden position-relative">
                  <div class="package-img-wrapper" style="height: 220px; overflow: hidden; position: relative;">
                    <img src="${pack.image_url}" class="card-img-top h-100 w-100 object-fit-cover transition-all" alt="${pack.name}">
                    <span class="badge bg-primary position-absolute top-3 end-3 px-3 py-2 fs-7 fw-semibold shadow-sm">${pack.duration}</span>
                  </div>
                  <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex align-items-center gap-1 text-primary fs-7 mb-2 fw-semibold">
                      <i class="fa-solid fa-location-dot"></i>
                      <span>${pack.destination}</span>
                    </div>
                    <h5 class="card-title fw-bold text-dark font-outfit mb-2">${pack.name}</h5>
                    <p class="card-text text-muted fs-7 mb-4 flex-grow-1">${pack.description}</p>
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                      <div>
                        <small class="text-muted fs-8 text-uppercase d-block mb-n1">Per Passenger</small>
                        <span class="fs-4 fw-extrabold text-primary font-outfit">$${parseFloat(pack.price).toLocaleString()}</span>
                      </div>
                      <a href="/login" class="btn btn-outline-primary rounded-pill px-4 fw-semibold fs-7 btn-book">Book Now</a>
                    </div>
                  </div>
                </div>
              </div>
            `;
            grid.insertAdjacentHTML('beforeend', cardHtml);
          });
        } else {
          grid.innerHTML = `
            <div class="col-12 text-center py-5">
              <div class="bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                <i class="fa-solid fa-map-location fs-1"></i>
              </div>
              <h5 class="fw-bold text-dark">No Travel Packages Found</h5>
              <p class="text-muted">No tour matched your search keyword. Try something else!</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Error fetching landing packages:', error);
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <h5 class="text-danger fw-bold">Failed to load packages</h5>
            <p class="text-muted">Please check your local database connection.</p>
          </div>
        `;
      }
    };

    // Load initial
    fetchPackages();

    // Trigger Search
    searchBtn.addEventListener('click', () => {
      fetchPackages(searchInput.value.trim());
    });

    searchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        fetchPackages(searchInput.value.trim());
      }
    });
  });
</script>

<%- include('partials/footer') %>
