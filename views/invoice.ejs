<%- include('partials/header') %>

<div class="container py-5 animate__animated animate__fadeIn">
  <!-- Invoice Command Row (No Print) -->
  <div class="d-flex justify-content-between align-items-center mb-4 no-print" style="max-width: 850px; margin: 0 auto;">
    <button onclick="window.history.back()" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold shadow-sm">
      <i class="fa-solid fa-arrow-left me-1"></i> Return to Dashboard
    </button>
    <button onclick="window.print()" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
      <i class="fa-solid fa-print me-1"></i> Print Invoice
    </button>
  </div>

  <!-- Main Invoice Card Sheet -->
  <div class="card invoice-card border shadow mx-auto p-5 rounded-4 bg-white text-dark">
    <!-- Invoice Header -->
    <div class="row align-items-center mb-5 pb-3 border-bottom">
      <div class="col-sm-6">
        <div class="d-flex align-items-center gap-2 mb-2">
          <div class="logo-icon bg-primary text-white d-flex align-items-center justify-content-center rounded-3" style="width: 38px; height: 38px;">
            <i class="fa-solid fa-plane-departure fs-5"></i>
          </div>
          <h3 class="logo-text fw-bold text-dark mb-0 font-outfit">Travel<span class="text-primary">Mate</span></h3>
        </div>
        <p class="text-muted fs-8 mb-0">100 Travel Way, Suite 400<br>Seattle, WA 98101, USA<br>support@travelmate.com</p>
      </div>
      <div class="col-sm-6 text-sm-end mt-3 mt-sm-0">
        <h2 class="fw-extrabold text-uppercase text-gradient font-outfit mb-1" style="font-size: 2.2rem; letter-spacing: 1px;">Invoice</h2>
        <span class="badge-status badge-<%= booking.status === 'confirmed' ? 'confirmed' : 'pending' %> px-3 py-1 fs-8">
          <%= booking.status %>
        </span>
      </div>
    </div>

    <!-- Client & Invoice Parameters Grid -->
    <div class="row mb-5 gy-4">
      <div class="col-sm-6">
        <span class="text-muted text-uppercase fw-semibold fs-8 letter-spacing-1 d-block mb-2">Passenger Information</span>
        <h5 class="fw-bold mb-1 text-dark"><%= booking.customer_name %></h5>
        <p class="text-muted fs-7 mb-0">
          <strong class="text-dark">Email:</strong> <%= booking.customer_phone ? 'Verified' : 'N/A' %><br>
          <strong class="text-dark">Phone:</strong> <%= booking.customer_phone || 'N/A' %><br>
          <strong class="text-dark">Passport:</strong> <%= booking.customer_passport || 'N/A' %><br>
          <strong class="text-dark">Address:</strong> <%= booking.customer_address || 'Not Provided' %>
        </p>
      </div>
      <div class="col-sm-6 text-sm-end">
        <span class="text-muted text-uppercase fw-semibold fs-8 letter-spacing-1 d-block mb-2">Invoice Details</span>
        <p class="text-muted fs-7 mb-0">
          <strong class="text-dark">Booking Ref:</strong> <code><%= booking.booking_reference %></code><br>
          <strong class="text-dark">Invoice ID:</strong> <code>#BKG-<%= booking.id %></code><br>
          <strong class="text-dark">Transaction ID:</strong> <code><%= booking.transaction_id || 'PENDING' %></code><br>
          <strong class="text-dark">Booking Date:</strong> <%= new Date(booking.booking_date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %><br>
          <strong class="text-dark">Departure Date:</strong> <%= new Date(booking.travel_date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' }) %><br>
          <strong class="text-dark">Payment Method:</strong> <%= booking.payment_method || 'Agent Provisioned' %>
        </p>
      </div>
    </div>

    <!-- Agent Assignment Callout -->
    <% if (booking.agent_name) { %>
      <div class="p-3 bg-light rounded-3 border mb-5 d-flex align-items-center gap-3">
        <div class="p-2 bg-white text-primary rounded-circle border d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
          <i class="fa-solid fa-user-tie fs-5"></i>
        </div>
        <div>
          <h6 class="fw-bold mb-0 text-dark">Assigned Travel Agent</h6>
          <small class="text-muted"><%= booking.agent_name %> | Phone: <%= booking.agent_phone || 'N/A' %></small>
        </div>
      </div>
    <% } %>

    <!-- Invoice Item Table -->
    <div class="table-responsive border mb-4">
      <table class="table align-middle">
        <thead>
          <tr class="bg-light">
            <th>Tour Package & Destination Inclusions</th>
            <th class="text-center">Rate</th>
            <th class="text-center">Passengers Count</th>
            <th class="text-end">Item Cost</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <h6 class="fw-bold mb-1 text-dark"><%= booking.package_name %></h6>
              <span class="text-primary fs-7"><i class="fa-solid fa-location-dot me-1"></i> <%= booking.package_destination %></span>
              <small class="text-muted d-block mt-1">Duration: <%= booking.package_duration %></small>
            </td>
            <td class="text-center fw-semibold text-dark">$<%= parseFloat(booking.package_unit_price).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></td>
            <td class="text-center fw-semibold text-dark"><%= booking.number_of_travelers %></td>
            <td class="text-end fw-extrabold text-primary">$<%= parseFloat(booking.total_price).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Summary Total Cost Grid -->
    <div class="row justify-content-end pt-3">
      <div class="col-sm-6 col-md-5 col-lg-4">
        <div class="d-flex justify-content-between mb-2">
          <span class="text-muted fs-7">Subtotal:</span>
          <span class="fw-semibold text-dark">$<%= parseFloat(booking.total_price).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></span>
        </div>
        <div class="d-flex justify-content-between mb-3 pb-2 border-bottom">
          <span class="text-muted fs-7">Sales Tax / GST:</span>
          <span class="fw-semibold text-success">Included (0.00%)</span>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
          <span class="fw-bold text-dark text-uppercase fs-6">Net Amount Paid:</span>
          <span class="fs-3 fw-extrabold text-primary font-outfit">$<%= parseFloat(booking.total_price).toLocaleString(undefined, { minimumFractionDigits: 2 }) %></span>
        </div>
      </div>
    </div>

    <!-- Billing Footer & Terms -->
    <div class="border-top pt-4 mt-5 text-center text-muted fs-8">
      <p class="mb-1"><strong>Terms & Conditions:</strong> Cancellation requests must be logged 7 days prior to departure. Refunds are processed dynamically.</p>
      <p class="mb-0">Thank you for traveling with TravelMate. We wish you an amazing journey!</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
