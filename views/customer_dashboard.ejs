<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container-fluid py-4 min-vh-100">
  <div class="row g-4">
    <!-- Left Sidebar Column -->
    <div class="col-lg-3 col-xl-2 d-none d-lg-block">
      <%- include('partials/sidebar') %>
    </div>

    <!-- Main Dynamic Workspace Column -->
    <div class="col-lg-9 col-xl-10">
      <!-- 1. AVAILABLE PACKAGES TAB PANEL -->
      <div id="packages-panel" class="dashboard-tab-panel animate__animated animate__fadeIn">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Book Your Next Adventure</h3>
            <p class="text-muted fs-7 mb-0">Browse global curated tour programs and lock in reservations instantly.</p>
          </div>
          <!-- Filter search box -->
          <div class="search-bar-wrapper shadow-sm rounded-pill overflow-hidden border" style="max-width: 320px;">
            <div class="input-group">
              <span class="input-group-text bg-white border-0 ps-3 text-muted"><i class="fa-solid fa-magnifying-glass fs-7"></i></span>
              <input type="text" id="custPackageSearch" class="form-control border-0 py-2 shadow-none fs-7" placeholder="Filter e.g. Alps, Rome...">
            </div>
          </div>
        </div>

        <!-- Dynamic packages cards grid -->
        <div class="row g-4 justify-content-center" id="custPackagesCardGrid">
          <!-- Loaded via AJAX -->
        </div>
      </div>

      <!-- 2. MY BOOKING HISTORY TAB PANEL -->
      <div id="bookings-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">My Booking History</h3>
            <p class="text-muted fs-7 mb-0">Track transaction invoices, travel schedule dates, and download printable invoice sheets.</p>
          </div>
        </div>

        <div class="card card-glass border-0 p-4 shadow-sm">
          <div class="table-responsive">
            <table class="table align-middle">
              <thead>
                <tr>
                  <th>Booking ID</th>
                  <th>Tour Package</th>
                  <th>Destination</th>
                  <th>Travel Date</th>
                  <th>Pax</th>
                  <th>Total Cost</th>
                  <th>Status</th>
                  <th>Payment</th>
                  <th class="text-end">Billing Actions</th>
                </tr>
              </thead>
              <tbody id="custBookingsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 3. MY PROFILE MANAGEMENT TAB PANEL -->
      <div id="profile-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="mb-4">
          <h3 class="fw-bold text-dark font-outfit mb-1">Account Profile Settings</h3>
          <p class="text-muted fs-7 mb-0">Manage your credentials, update contact information, and securely reset your password.</p>
        </div>

        <div class="row g-4">
          <div class="col-xl-8">
            <div class="card card-glass border-0 p-4 shadow-sm">
              <form id="profileUpdateForm" class="needs-validation" novalidate>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h5 class="fw-bold mb-0 font-outfit text-dark"><i class="fa-solid fa-id-card text-primary me-2"></i> Profile Details</h5>
                  <button type="button" id="editProfileBtn" class="btn btn-light-primary btn-sm rounded-pill px-3 fw-semibold fs-8"><i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile</button>
                </div>
                
                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Full Name *</label>
                    <input type="text" name="name" id="profName" class="form-control rounded-pill fs-7 py-2" required disabled>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Email Address *</label>
                    <input type="email" name="email" id="profEmail" class="form-control rounded-pill fs-7 py-2" required disabled>
                  </div>
                </div>

                <div class="row g-3 mb-3">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Phone Number *</label>
                    <input type="text" name="phone" id="profPhone" class="form-control rounded-pill fs-7 py-2" pattern="\d{10}" title="Phone number must contain exactly 10 digits" required disabled>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Passport Number (Required for Int'l Travel)</label>
                    <input type="text" name="passport_number" id="profPassport" class="form-control rounded-pill fs-7 py-2" disabled>
                  </div>
                </div>

                <div class="mb-4">
                  <label class="form-label fw-semibold text-dark fs-8 mb-1">Residential Address</label>
                  <textarea name="address" id="profAddress" class="form-control rounded-3 fs-7" rows="2" disabled></textarea>
                </div>

                <div id="profileEditActions" class="d-none">
                  <hr class="my-4">

                  <h5 class="fw-bold mb-3 font-outfit text-dark"><i class="fa-solid fa-lock text-primary me-2"></i> Update Security Credentials</h5>
                  <p class="text-muted fs-8 mb-3">Leave password fields blank if you do not wish to change your credentials.</p>

                  <div class="row g-3 mb-4">
                    <div class="col-md-6">
                      <label class="form-label fw-semibold text-dark fs-8 mb-1">Current Password</label>
                      <input type="password" name="currentPassword" id="profCurrentPassword" class="form-control rounded-pill fs-7 py-2" placeholder="••••••••" minlength="6">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-semibold text-dark fs-8 mb-1">New Secure Password</label>
                      <input type="password" name="newPassword" id="profNewPassword" class="form-control rounded-pill fs-7 py-2" placeholder="••••••••" minlength="6">
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold fs-7 shadow-sm">
                      <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile Modifications
                    </button>
                    <button type="button" id="cancelEditBtn" class="btn btn-light text-dark border rounded-pill px-4 py-2 fw-semibold fs-7 shadow-sm">
                      Cancel
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="col-xl-4">
            <div class="card card-glass border-0 p-4 shadow-sm text-center">
              <div class="profile-avatar bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center border" style="width: 90px; height: 90px;">
                <i class="fa-solid fa-circle-user fs-1"></i>
              </div>
              <h5 class="fw-bold mb-1 text-dark" id="sideCardName"><%= user.displayName %></h5>
              <span class="badge bg-primary rounded-pill px-3 py-1 text-capitalize fs-7 mb-3"><%= user.role %></span>
              <p class="text-muted fs-8 mb-0 border-top pt-3 text-start">
                <strong class="text-dark">Username:</strong> <code><%= user.username %></code><br>
                <strong class="text-dark">Role Permission:</strong> Customer Passenger<br>
                <strong class="text-dark">Platform Brand:</strong> TravelMate Premium
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =====================================================================
     MODALS FOR CUSTOMER SELF-SERVICE FLOW
     ===================================================================== -->

<!-- 1. Customer Place Booking Confirmation Modal -->
<div class="modal fade" id="confirmBookingModal" tabindex="-1" aria-labelledby="confirmBookingModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark font-outfit" id="confirmBookingModalLabel"><i class="fa-solid fa-plane-departure text-primary me-2"></i> Book Tour Package</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="p-3 bg-light-primary rounded-3 border border-primary-subtle mb-3 text-center">
          <h6 class="fw-bold text-dark mb-1" id="bookModalPackageName">Tropical Paradise</h6>
          <span class="fs-7 text-primary fw-semibold"><i class="fa-solid fa-location-dot me-1"></i> <span id="bookModalDestination">Maldives</span></span>
          <div class="d-flex justify-content-center gap-4 mt-2 pt-2 border-top border-primary-subtle">
            <small class="text-muted">Rate: <strong class="text-dark font-outfit" id="bookModalRate">$0</strong></small>
            <small class="text-muted">Duration: <strong class="text-dark" id="bookModalDuration">5 Days</strong></small>
          </div>
        </div>

        <form id="confirmBookingForm" class="needs-validation" novalidate>
          <input type="hidden" name="package_id" id="bookModalPackageId">
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Departure Date *</label>
              <input type="date" name="travel_date" class="form-control rounded-pill fs-7 py-2" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Passengers Count *</label>
              <input type="number" name="number_of_travelers" id="bookModalTravelers" class="form-control rounded-pill fs-7 py-2" value="1" min="1" required>
            </div>
          </div>

          <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded-3 border">
            <span class="fw-semibold text-dark">Estimated Total:</span>
            <span class="fs-4 fw-extrabold text-primary font-outfit" id="bookModalTotalCost">$0.00</span>
          </div>

          <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold fs-7 shadow-sm">Confirm Booking Request</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 2. Customer Simulated Payment Checkout Modal -->
<div class="modal fade" id="paymentCheckoutModal" tabindex="-1" aria-labelledby="paymentCheckoutModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark font-outfit" id="paymentCheckoutModalLabel"><i class="fa-solid fa-credit-card text-primary me-2"></i> Payment Gateway Checkout</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning fs-8" role="alert">
          <i class="fa-solid fa-circle-info me-1"></i> This is a simulated checkout gateway demonstrating relational DBMS updates and transaction consistency.
        </div>

        <form id="paymentForm">
          <input type="hidden" name="booking_id" id="checkoutBookingId">
          <div class="mb-3 p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center">
            <div>
              <small class="text-muted text-uppercase d-block mb-n1">Transaction Billing Total</small>
              <span class="fw-bold text-dark" id="checkoutBookingName">Maldives Holiday package</span>
            </div>
            <span class="fs-4 fw-extrabold text-primary font-outfit" id="checkoutBookingCost">$0.00</span>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Choose Payment Method *</label>
            <select name="payment_method" class="form-select rounded-pill fs-7 py-2" required>
              <option value="Credit Card">💳 Credit Card (Mastercard/Visa)</option>
              <option value="PayPal">🌐 PayPal Account</option>
              <option value="Bank Transfer">🏛 Bank Wire Transfer</option>
            </select>
          </div>

          <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold fs-7 shadow-sm">
            <i class="fa-solid fa-shield-halved me-1"></i> Pay Invoice & Confirm Booking
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Customer Client Script -->
<script src="/js/customer.js"></script>

<%- include('partials/footer') %>
