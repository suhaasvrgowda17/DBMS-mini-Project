<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container-fluid py-4 min-vh-100">
  <div class="row g-4">
    <!-- Left Sidebar Column -->
    <div class="col-lg-3 col-xl-2 d-none d-lg-block">
      <%- include('partials/sidebar') %>
    </div>

    <!-- Main Dynamic Workspace Column -->
    <div class="col-lg-9 col-xl-10">
      <!-- 1. STATS TAB PANEL -->
      <div id="stats-panel" class="dashboard-tab-panel animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Administrative Center</h3>
            <p class="text-muted fs-7 mb-0">Aggregate counters and active transactions logs.</p>
          </div>
          <button class="btn btn-primary rounded-pill px-4" onclick="loadDashboardStats()"><i class="fa-solid fa-arrows-rotate me-2"></i> Refresh Data</button>
        </div>

        <!-- Metric Counter Grid -->
        <div class="row g-4 mb-5">
          <div class="col-md-6 col-xl-3">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted fs-7 fw-semibold text-uppercase">Total Billing Revenue</span>
                <span class="p-2 bg-light-primary text-primary rounded-3"><i class="fa-solid fa-sack-dollar fs-5"></i></span>
              </div>
              <h3 class="fw-extrabold font-outfit text-gradient mb-1" id="stat-revenue">$0.00</h3>
              <small class="text-success fw-semibold"><i class="fa-solid fa-arrow-trend-up me-1"></i> Live earnings</small>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted fs-7 fw-semibold text-uppercase">Total Bookings</span>
                <span class="p-2 bg-light-primary text-primary rounded-3"><i class="fa-solid fa-clipboard-list fs-5"></i></span>
              </div>
              <h3 class="fw-extrabold font-outfit text-dark mb-1" id="stat-bookings">0</h3>
              <small class="text-muted fw-semibold">Reservations registered</small>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted fs-7 fw-semibold text-uppercase">Active Packages</span>
                <span class="p-2 bg-light-primary text-primary rounded-3"><i class="fa-solid fa-map-location-dot fs-5"></i></span>
              </div>
              <h3 class="fw-extrabold font-outfit text-dark mb-1" id="stat-packages">0</h3>
              <small class="text-muted fw-semibold">Tour programs</small>
            </div>
          </div>
          <div class="col-md-6 col-xl-3">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted fs-7 fw-semibold text-uppercase">Active Agents</span>
                <span class="p-2 bg-light-primary text-primary rounded-3"><i class="fa-solid fa-user-tie fs-5"></i></span>
              </div>
              <h3 class="fw-extrabold font-outfit text-dark mb-1" id="stat-agents">0</h3>
              <small class="text-muted fw-semibold">Assigned specialists</small>
            </div>
          </div>
        </div>

        <div class="row g-4">
          <!-- Recent Bookings -->
          <div class="col-xl-7">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
                <h5 class="fw-bold text-dark font-outfit mb-0"><i class="fa-solid fa-bookmark me-2 text-primary"></i> Recent Master Bookings</h5>
                <button class="btn btn-light btn-sm rounded-pill px-3" onclick="switchTab('bookings')">View All</button>
              </div>
              <div class="table-responsive">
                <table class="table align-middle">
                  <thead>
                    <tr>
                      <th>Passenger</th>
                      <th>Destination</th>
                      <th>Total</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody id="statsRecentBookings">
                    <tr><td colspan="4" class="text-center py-4 text-muted">No reservations recorded.</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <!-- Recent Payments -->
          <div class="col-xl-5">
            <div class="card card-glass border-0 p-4 shadow-sm h-100">
              <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
                <h5 class="fw-bold text-dark font-outfit mb-0"><i class="fa-solid fa-file-invoice-dollar me-2 text-primary"></i> Recent Payments</h5>
                <button class="btn btn-light btn-sm rounded-pill px-3" onclick="switchTab('payments')">View All</button>
              </div>
              <div class="table-responsive">
                <table class="table align-middle">
                  <thead>
                    <tr>
                      <th>Amount</th>
                      <th>Method</th>
                      <th>Status</th>
                    </tr>
                  </thead>
                  <tbody id="statsRecentPayments">
                    <tr><td colspan="3" class="text-center py-4 text-muted">No payment logs recorded.</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. AGENTS TAB PANEL -->
      <div id="agents-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Travel Agents Directory</h3>
            <p class="text-muted fs-7 mb-0">Configure agent profiles, commissions, and logins.</p>
          </div>
          <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addAgentModal"><i class="fa-solid fa-user-plus me-2"></i> Register New Agent</button>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">AGENTS DIRECTORY</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Agent Name</th>
                  <th>Username</th>
                  <th>Email</th>
                  <th>Phone Number</th>
                  <th>Commission</th>
                  <th>Status</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="agentsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 3. CUSTOMERS TAB PANEL -->
      <div id="customers-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Passengers Directory</h3>
            <p class="text-muted fs-7 mb-0">System passenger profiles and active assignments.</p>
          </div>
          <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addCustomerModal"><i class="fa-solid fa-user-plus me-2"></i> Add Passenger</button>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">PASSENGERS DIRECTORY</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Passenger Name</th>
                  <th>Username</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Passport</th>
                  <th>Assigned Agent</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="customersTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 4. TOUR PACKAGES TAB PANEL -->
      <div id="packages-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Tour Packages Catalog</h3>
            <p class="text-muted fs-7 mb-0">Create, edit, and filter promotional holiday packages.</p>
          </div>
          <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addPackageModal"><i class="fa-solid fa-square-plus me-2"></i> Create Package</button>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">TOUR PACKAGES CATALOG</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Preview</th>
                  <th>Package Name</th>
                  <th>Destination</th>
                  <th>Price</th>
                  <th>Duration</th>
                  <th>Description</th>
                  <th>Assigned Agents</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody id="packagesTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 5. MASTER BOOKINGS TAB PANEL -->
      <div id="bookings-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Master Bookings Registry</h3>
            <p class="text-muted fs-7 mb-0">Unified dashboard for booking statuses across agents and customers.</p>
          </div>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">MASTER BOOKINGS REGISTRY</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Booking ID</th>
                  <th>Passenger</th>
                  <th>Tour Package</th>
                  <th>Agent</th>
                  <th>Travel Date</th>
                  <th>Pax</th>
                  <th>Total Cost</th>
                  <th>Status</th>
                  <th class="text-end">Billing</th>
                </tr>
              </thead>
              <tbody id="bookingsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 6. PAYMENTS RECORDS TAB PANEL -->
      <div id="payments-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Payments Audit Logs</h3>
            <p class="text-muted fs-7 mb-0">Record of transactions and invoice print registers.</p>
          </div>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">PAYMENTS AUDIT LOGS</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Transaction ID</th>
                  <th>Passenger</th>
                  <th>Tour Package</th>
                  <th>Amount</th>
                  <th>Payment Method</th>
                  <th>Date Logged</th>
                  <th>Invoice Status</th>
                  <th class="text-end">Print Receipt</th>
                </tr>
              </thead>
              <tbody id="paymentsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 7. DISCOUNTS TAB PANEL -->
      <div id="discounts-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">Discounts & Promo Codes</h3>
            <p class="text-muted fs-7 mb-0">View all active and inactive discount coupons.</p>
          </div>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">ACTIVE DISCOUNTS DIRECTORY</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>Promo Code</th>
                  <th>Discount %</th>
                  <th>Max Discount</th>
                  <th>Expiry Date</th>
                  <th>Status</th>
                </tr>
              </thead>
              <tbody id="discountsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 7.5. SYSTEM ADMINISTRATORS TAB PANEL -->
      <div id="admins-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <div>
            <h3 class="fw-bold text-dark font-outfit mb-1">System Administrators Directory</h3>
            <p class="text-muted fs-7 mb-0">View all registered administrative accounts and active sub-roles.</p>
          </div>
        </div>

        <div class="table-report-wrapper">
          <div class="table-report-title">REGISTERED ADMINISTRATIVE STAFF</div>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="table-report align-middle">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Full Name</th>
                  <th>Username</th>
                  <th>Email Address</th>
                  <th>Sub-Role</th>
                  <th>Account Created</th>
                </tr>
              </thead>
              <tbody id="adminsTableBody">
                <!-- Loaded via AJAX -->
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 8. MY PROFILE MANAGEMENT TAB PANEL -->
      <div id="profile-panel" class="dashboard-tab-panel d-none animate__animated animate__fadeIn">
        <div class="mb-4">
          <h3 class="fw-bold text-dark font-outfit mb-1">Administrator Profile Settings</h3>
          <p class="text-muted fs-7 mb-0">Manage your administrative credentials, email contacts, and securely reset your root security password.</p>
        </div>

        <div class="row g-4">
          <div class="col-xl-8">
            <div class="card card-glass border-0 p-4 shadow-sm">
              <form id="profileUpdateForm" class="needs-validation" novalidate>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <h5 class="fw-bold mb-0 font-outfit text-dark"><i class="fa-solid fa-id-card text-primary me-2"></i> Profile Details</h5>
                  <button type="button" id="editProfileBtn" class="btn btn-light-primary btn-sm rounded-pill px-3 fw-semibold fs-8"><i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile</button>
                </div>
                
                <div class="row g-3 mb-4">
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Full Admin Name *</label>
                    <input type="text" name="name" id="profName" class="form-control rounded-pill fs-7 py-2" required disabled>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Phone Number *</label>
                    <input type="text" name="phone" id="profPhone" class="form-control rounded-pill fs-7 py-2" pattern="\d{10}" title="Phone number must contain exactly 10 digits" required disabled>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label fw-semibold text-dark fs-8 mb-1">Email Address *</label>
                    <input type="email" name="email" id="profEmail" class="form-control rounded-pill fs-7 py-2" required disabled>
                  </div>
                </div>

                <div id="profileEditActions" class="d-none">
                  <hr class="my-4">

                  <h5 class="fw-bold mb-3 font-outfit text-dark"><i class="fa-solid fa-lock text-primary me-2"></i> Update Security Credentials</h5>
                  <p class="text-muted fs-8 mb-3">Leave password fields blank if you do not wish to change your credentials.</p>

                  <div class="row g-3 mb-4">
                    <div class="col-md-6">
                      <label class="form-label fw-semibold text-dark fs-8 mb-1">Current Password</label>
                      <input type="password" name="currentPassword" id="profCurrentPassword" class="form-control rounded-pill fs-7 py-2" placeholder="••••••••" minlength="6">
                    </div>
                    <div class="col-md-6">
                      <label class="form-label fw-semibold text-dark fs-8 mb-1">New Secure Password</label>
                      <input type="password" name="newPassword" id="profNewPassword" class="form-control rounded-pill fs-7 py-2" placeholder="••••••••" minlength="6">
                    </div>
                  </div>

                  <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold fs-7 shadow-sm">
                      <i class="fa-solid fa-floppy-disk me-1"></i> Save Profile Modifications
                    </button>
                    <button type="button" id="cancelEditBtn" class="btn btn-light text-dark border rounded-pill px-4 py-2 fw-semibold fs-7 shadow-sm">
                      Cancel
                    </button>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <div class="col-xl-4">
            <div class="card card-glass border-0 p-4 shadow-sm text-center">
              <div class="profile-avatar bg-light-primary text-primary mx-auto mb-3 rounded-circle d-flex align-items-center justify-content-center border" style="width: 90px; height: 90px;">
                <i class="fa-solid fa-user-shield fs-1"></i>
              </div>
              <h5 class="fw-bold mb-1 text-dark" id="sideCardName"><%= user.displayName %></h5>
              <span class="badge bg-danger rounded-pill px-3 py-1 text-capitalize fs-7 mb-3"><%= user.role %> Control</span>
              <p class="text-muted fs-8 mb-0 border-top pt-3 text-start">
                <strong class="text-dark">Username:</strong> <code><%= user.username %></code><br>
                <strong class="text-dark">Role Permission:</strong> Platform Root Superuser<br>
                <strong class="text-dark">Platform Brand:</strong> TravelMate Premium
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =====================================================================
     MODAL FORMS DEFINITIONS
     ===================================================================== -->

<!-- 1. Add Agent Modal -->
<div class="modal fade" id="addAgentModal" tabindex="-1" aria-labelledby="addAgentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark font-outfit" id="addAgentModalLabel"><i class="fa-solid fa-user-plus text-primary me-2"></i> Register New Agent</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addAgentForm" class="needs-validation" novalidate>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Full Agent Name *</label>
            <input type="text" name="name" class="form-control rounded-pill fs-7 py-2" placeholder="e.g. John Miller" required>
          </div>
          <div class="row g-2">
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Username *</label>
              <input type="text" name="username" class="form-control rounded-pill fs-7 py-2" placeholder="e.g. john_miller" required>
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Email Address *</label>
              <input type="email" name="email" class="form-control rounded-pill fs-7 py-2" placeholder="john@travelagency.com" required>
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Agent Phone *</label>
            <input type="text" name="phone" class="form-control rounded-pill fs-7 py-2" placeholder="+1 (555) 304-2034" required>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Secure Password *</label>
              <input type="password" name="password" class="form-control rounded-pill fs-7 py-2" placeholder="Min. 6 characters" minlength="6" required>
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Commission %</label>
              <input type="number" name="agency_commission" class="form-control rounded-pill fs-7 py-2" placeholder="10.00" value="10.00" step="0.01" min="0">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Status</label>
            <select name="status" class="form-select rounded-pill fs-7 py-2">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>
          <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold fs-7 shadow-sm">Save Agent Account</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 2. Edit Agent Modal -->
<div class="modal fade" id="editAgentModal" tabindex="-1" aria-labelledby="editAgentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark font-outfit" id="editAgentModalLabel"><i class="fa-solid fa-user-pen text-primary me-2"></i> Edit Agent Details</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="editAgentForm">
          <input type="hidden" name="id" id="editAgentId">
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Full Agent Name *</label>
            <input type="text" name="name" id="editAgentName" class="form-control rounded-pill fs-7 py-2" required>
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Agent Phone *</label>
            <input type="text" name="phone" id="editAgentPhone" class="form-control rounded-pill fs-7 py-2" required>
          </div>
          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Commission %</label>
              <input type="number" name="agency_commission" id="editAgentCommission" class="form-control rounded-pill fs-7 py-2" step="0.01" required>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Status</label>
              <select name="status" id="editAgentStatus" class="form-select rounded-pill fs-7 py-2">
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold fs-7 shadow-sm">Update Agent Account</button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- 3. Add Customer Modal -->
<div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content card-glass border-0 p-3 shadow-lg">
      <div class="modal-header border-bottom-0 pb-0">
        <h5 class="modal-title fw-bold text-dark font-outfit" id="addCustomerModalLabel"><i class="fa-solid fa-user-plus text-primary me-2"></i> Register New Customer</h5>
        <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="addCustomerForm" class="needs-validation" novalidate>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Customer Full Name *</label>
            <input type="text" name="name" class="form-control rounded-pill fs-7 py-2" placeholder="e.g. Charlie Brown" required>
          </div>
          <div class="row g-2">
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Username *</label>
              <input type="text" name="username" class="form-control rounded-pill fs-7 py-2" placeholder="charlie_b" required>
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Email *</label>
              <input type="email" name="email" class="form-control rounded-pill fs-7 py-2" placeholder="charlie@gmail.com" required>
            </div>
          </div>
          <div class="row g-2">
            <div class="col-md-6">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Phone Number *</label>
              <input type="text" name="phone" class="form-control rounded-pill fs-7 py-2" placeholder="10-digit number" pattern="\d{10}" title="Phone number must contain exactly 10 digits" required>
            </div>
            <div class="col-md-6 mb-2">
              <label class="form-label fw-semibold text-dark fs-8 mb-1">Passport Number</label>
              <input type="text" name="passport_number" class="form-control rounded-pill fs-7 py-2" placeholder="e.g. C18294719">
            </div>
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Password *</label>
            <input type="password" name="password" class="form-control rounded-pill fs-7 py-2" placeholder="••••••••" minlength="6" required>
          </div>
          <div class="mb-2">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Home Address</label>
            <input type="text" name="address" class="form-control rounded-pill fs-7 py-2" placeholder="100 Pine St, Suite 2">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold text-dark fs-8 mb-1">Assigned Agent</label>
            <select name="assigned_agent_id" class="form-select rounded-pill fs-7 py-2">
              <option value="">-- No Assigned Agent --</option>
              <% if (typeof agentsList !== 'undefined' && agentsList.length > 0) { %>
                <% agentsList.forEach(agent => { %>
                  <option value="<%= agent.id %>"><%= agent.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <button type="submit" class="btn btn-primary rounded-pill w-100 py-2 fw-semibold fs-7 shadow-sm">Save Customer Profile</button>
        </form>
      </div>
    </div>
  </div>
</div>

