          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 bg-light-primary px-3 py-2 rounded-pill border border-primary-subtle text-primary fw-semibold" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
