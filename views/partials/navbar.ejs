        <li class="nav-item">
          <a class="nav-link fw-semibold text-dark-secondary" href="/"><i class="fa-solid fa-house me-1 opacity-75"></i> Home</a>
        </li>
        
        <% if (user) { %>
          <!-- Dashboard Links according to user role -->
          <li class="nav-item">
            <% if (user.role === 'admin') { %>
              <a class="nav-link fw-semibold text-dark-secondary" href="/admin/dashboard"><i class="fa-solid fa-gauge-high me-1 opacity-75"></i> Admin Panel</a>
            <% } else if (user.role === 'agent') { %>
              <a class="nav-link fw-semibold text-dark-secondary" href="/agent/dashboard"><i class="fa-solid fa-briefcase me-1 opacity-75"></i> Agent Desk</a>
            <% } else { %>
              <a class="nav-link fw-semibold text-dark-secondary" href="/customer/dashboard"><i class="fa-solid fa-compass me-1 opacity-75"></i> Travel Planner</a>
            <% } %>
          </li>
          
