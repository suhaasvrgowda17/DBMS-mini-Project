<!-- Responsive Sidebar Menu -->
<div class="sidebar-wrapper bg-white shadow-sm border-end h-100 py-4 px-3 rounded-4 animate__animated animate__fadeInLeft">
  <!-- Profile Summary inside Sidebar -->
  <div class="sidebar-profile text-center mb-4 pb-3 border-bottom">
    <div class="profile-avatar bg-light-primary text-primary mx-auto mb-2 rounded-circle d-flex align-items-center justify-content-center border" style="width: 70px; height: 70px;">
      <i class="fa-solid fa-user-tie fs-1"></i>
    </div>
    <h6 class="fw-bold mb-0 text-dark"><%= user.displayName %></h6>
    <small class="text-muted text-uppercase fw-semibold fs-7 letter-spacing-1"><%= user.role %> Account</small>
  </div>

  <!-- Dynamic Navigation Sections -->
  <ul class="nav flex-column sidebar-nav gap-2">
    <% if (user.role === 'admin') { %>
      <% if (user.admin_level === 'super_admin' || user.admin_level === 'payment_verifier') { %>
      <li class="nav-item">
        <a class="nav-link active rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-stats-tab" href="#" onclick="switchTab('stats')">
          <i class="fa-solid fa-chart-pie fs-5 text-primary"></i> Dashboard Stats
        </a>
      </li>
      <% } %>
      
      <% if (user.admin_level === 'super_admin' || user.admin_level === 'customer_manager') { %>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-agents-tab" href="#" onclick="switchTab('agents')">
          <i class="fa-solid fa-user-gear fs-5 text-primary"></i> Travel Agents
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-customers-tab" href="#" onclick="switchTab('customers')">
          <i class="fa-solid fa-users fs-5 text-primary"></i> Customers List
        </a>
      </li>
      <% } %>

      <% if (user.admin_level === 'super_admin' || user.admin_level === 'package_manager') { %>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-packages-tab" href="#" onclick="switchTab('packages')">
          <i class="fa-solid fa-map-location-dot fs-5 text-primary"></i> Tour Packages
        </a>
      </li>
      <% } %>

      <% if (user.admin_level === 'super_admin' || user.admin_level === 'customer_manager' || user.admin_level === 'package_manager' || user.admin_level === 'payment_verifier') { %>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-bookings-tab" href="#" onclick="switchTab('bookings')">
          <i class="fa-solid fa-bookmark fs-5 text-primary"></i> Master Bookings
        </a>
      </li>
      <% } %>

      <% if (user.admin_level === 'super_admin' || user.admin_level === 'payment_verifier') { %>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-payments-tab" href="#" onclick="switchTab('payments')">
          <i class="fa-solid fa-file-invoice-dollar fs-5 text-primary"></i> Payment Records
        </a>
      </li>
      <% } %>

      <% if (user.admin_level === 'super_admin' || user.admin_level === 'package_manager') { %>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-discounts-tab" href="#" onclick="switchTab('discounts')">
          <i class="fa-solid fa-tags fs-5 text-primary"></i> Discounts
        </a>
      </li>
      <% } %>
    <% } else if (user.role === 'agent') { %>
      <li class="nav-item">
        <a class="nav-link active rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-customers-tab" href="#" onclick="switchTab('customers')">
          <i class="fa-solid fa-users fs-5 text-primary"></i> Assigned Clients
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-bookings-tab" href="#" onclick="switchTab('bookings')">
          <i class="fa-solid fa-bookmark fs-5 text-primary"></i> Manage Bookings
        </a>
      </li>
    <% } else { %>
      <li class="nav-item">
        <a class="nav-link active rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-packages-tab" href="#" onclick="switchTab('packages')">
          <i class="fa-solid fa-compass fs-5 text-primary"></i> Book New Package
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-bookings-tab" href="#" onclick="switchTab('bookings')">
          <i class="fa-solid fa-clock-rotate-left fs-5 text-primary"></i> My Booking History
        </a>
      </li>
    <% } %>
    <li class="nav-item">
      <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-secondary" id="v-profile-tab" href="#" onclick="switchTab('profile')">
        <i class="fa-solid fa-user-gear fs-5 text-primary"></i> My Profile
      </a>
    </li>
    
    <li class="nav-item mt-4 border-top pt-3">
      <a class="nav-link rounded-3 py-2 px-3 fw-semibold d-flex align-items-center gap-3 text-danger" href="/api/auth/logout">
        <i class="fa-solid fa-right-from-bracket fs-5"></i> Logout Session
      </a>
    </li>
  </ul>
</div>
